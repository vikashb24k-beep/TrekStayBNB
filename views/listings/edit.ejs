<% layout("/layouts/boilerplate") %>

    <div class="row mt-4">

    <div class="col-8 offset-2">
    <h1 class="mb-4">Edit Your Listings</h1>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">

                    <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label">
                    Title
                </label>

                <input
                    type="text"
                    placeholder="<%=listing.title%>"
                    name="listing[title]"
                    class="form-control"
                    required
                >
            </div>

                        <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    name="listing[description]"
                    class="form-control"
                    placeholder="<%=listing.description%>"
                    required
                ></textarea>
            </div>

              <!-- Image -->
            <div class="mb-3">
                <label for="image" class="form-label">
                    Image URL
                </label>

                <input
                    type="text"
                    placeholder="<%=listing.image%>"
                    name="listing[image][url]"
                    class="form-control"
                >
            </div>


            <!-- Price -->
            <div class="mb-3">
                <label for="price" class="form-label">
                    Price
                </label>

                <input
                    type="number"
                    placeholder="<%=listing.price%>"
                    name="listing[price]"
                    class="form-control"
                    required
                >
            </div>

             <!-- Location + Country -->
            <div class="row">

                <div class="mb-3 col-md-8">
                    <label for="location" class="form-label">
                        Location
                    </label>

                    <input
                        type="text"
                        placeholder="<%=listing.location%>"
                        name="listing[location]"
                        class="form-control"
                        required
                    >
                </div>


                <div class="mb-3 col-md-4">
                    <label for="country" class="form-label">
                        Country
                    </label>

                    <input
                        type="text"
                        placeholder="<%=listing.country%>"
                        name="listing[country]"
                        class="form-control"
                        required
                    >
                </div>

            </div>
             <!-- Submit -->
            <button type="submit" class="btn btn-dark">
                Edit Button
            </button>
 </form>
