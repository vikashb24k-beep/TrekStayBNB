<% layout('/layouts/boilerplate') %>

<div class="row mt-4">
    <div class="col-12 col-lg-8 offset-lg-2">
        <h1 class="mb-4">Edit listing</h1>
        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input id="title" type="text" value="<%= listing.title %>" name="listing[title]" class="form-control" required>
                <div class="invalid-feedback">Enter a title.</div>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea id="description" name="listing[description]" class="form-control" rows="4" required><%= listing.description %></textarea>
                <div class="invalid-feedback">Enter a description.</div>
            </div>
            <div class="mb-3">
                <label for="image-url" class="form-label">Image URL</label>
                <input id="image-url" type="text" value="<%= listing.image?.url || '' %>" name="listing[image][url]" class="form-control" placeholder="https://example.com/image.jpg" data-image-url-input data-preview-target="#listing-image-preview">
                <div class="form-text">Use an HTTP or HTTPS URL, or upload a replacement below.</div>
            </div>
            <div class="mb-3">
                <label for="image-file" class="form-label">Upload replacement image (optional)</label>
                <input id="image-file" type="file" name="listing[image]" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control" data-image-file-input data-preview-target="#listing-image-preview">
                <div class="form-text">JPG, PNG, GIF, or WebP up to 5 MB.</div>
            </div>
            <div class="mb-3" id="listing-image-preview-container">
                <p class="form-label mb-2">Image preview</p>
                <img
                    id="listing-image-preview"
                    src="<%= listing.image?.url || '/images/listing-placeholder.svg' %>"
                    data-fallback-src="/images/listing-placeholder.svg"
                    class="img-fluid rounded border"
                    alt="Listing image preview"
                    style="max-height: 280px;"
                >
            </div>
            <div class="mb-3">
                <label for="price" class="form-label">Price per night</label>
                <input id="price" type="number" min="0" step="0.01" value="<%= listing.price %>" name="listing[price]" class="form-control" required>
                <div class="invalid-feedback">Enter a price of zero or more.</div>
            </div>
            <div class="row">
                <div class="mb-3 col-md-8">
                    <label for="location" class="form-label">Location</label>
                    <input id="location" type="text" value="<%= listing.location %>" name="listing[location]" class="form-control" required>
                    <div class="invalid-feedback">Enter a location.</div>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="country" class="form-label">Country</label>
                    <input id="country" type="text" value="<%= listing.country %>" name="listing[country]" class="form-control" required>
                    <div class="invalid-feedback">Enter a country.</div>
                </div>
            </div>
            <button type="submit" class="btn btn-dark">Save changes</button>
            <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
