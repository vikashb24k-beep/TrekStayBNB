<% layout('/layouts/boilerplate') %>

<div class="row mt-5">
    <div class="col-12 col-lg-8 offset-lg-2">
        <h1 class="mb-3"><%= listing.title %></h1>
        <div class="card">
            <img
                src="<%= listing.image?.url || '/images/listing-placeholder.svg' %>"
                onerror="this.onerror=null; this.src='/images/listing-placeholder.svg';"
                class="card-img-top show-img"
                alt="<%= listing.title %>"
            >

            <div class="card-body">
                <p class="card-text"><strong>Owner:</strong> <%= listing.owner?.username || 'Community listing' %></p>
                <p class="card-text"><strong>Description:</strong> <%= listing.description %></p>
                <p class="card-text"><strong>Price:</strong> &#8377; <%= listing.price.toLocaleString('en-IN') %> / night</p>
                <p class="card-text"><strong>Location:</strong> <%= listing.location %></p>
                <p class="card-text mb-0"><strong>Country:</strong> <%= listing.country %></p>
            </div>
        </div>

        <% if (currentUser && listing.owner && String(currentUser._id) === String(listing.owner._id)) { %>
            <div class="mt-4 mb-5">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                    <button type="submit" class="btn btn-danger">Delete this listing</button>
                </form>
            </div>
        <% } %>

        <hr>
        <section class="mt-5">
            <h2 class="h4">Leave a review</h2>
            <% if (currentUser) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <input id="rating" class="form-range" type="range" min="1" max="5" value="3" name="review[rating]" required>
                        <div class="d-flex justify-content-between small text-muted"><span>1</span><span>5</span></div>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea id="comment" name="review[comment]" rows="4" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please enter a comment.</div>
                    </div>
                    <button type="submit" class="btn btn-dark">Submit review</button>
                </form>
            <% } else { %>
                <p><a href="/login">Sign in</a> to leave a review.</p>
            <% } %>
        </section>

        <section class="mt-5 mb-5">
            <h2 class="h4 mb-4">Reviews (<%= listing.reviews.length %>)</h2>
            <% if (!listing.reviews.length) { %>
                <p class="text-muted">No reviews yet.</p>
            <% } %>
            <div class="row">
                <% for (const review of listing.reviews) { %>
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h5">Rating: <span class="text-warning"><%= review.rating %> &#9733;</span>

                                <% if (review.author) { %>
                                    <span class="small text-muted"> <br> <i>Author :</i> <%= review.author.username %></span>
                                <% } else { %>
                                    <span class="small text-muted">by Unknown</span>
                                <% } %>
                                </h3>
                                <p class="card-text"><%= review.comment %></p>
                                <p class="small text-muted mb-0">Created: <%= review.createdAt.toLocaleString() %></p>
                                <% if (currentUser && review.author && String(currentUser._id) === String(review.author._id || review.author)) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-3">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete review</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
    </div>
</div>
