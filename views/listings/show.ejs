<% layout("/layouts/boilerplate") %>

<div class="row mt-5">

    <div class="col-8 offset-2">

        <h2 class="mb-4">Listing Details</h2>

        <div class="card">

            <img
                src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="<%= listing.title %>"
            >

            <div class="card-body">

                <h3 class="card-title">
                    <%= listing.title %>
                </h3>

                <p class="card-text">
                    <strong>Description:</strong>
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <strong>Price:</strong>
                    ₹ <%= listing.price.toLocaleString("en-IN") %>
                </p>

                <p class="card-text">
                    <strong>Location:</strong>
                    <%= listing.location %>
                </p>

                <p class="card-text">
                    <strong>Country:</strong>
                    <%= listing.country %>
                </p>

            </div>

        </div>


        <!-- Buttons -->

        <div class="mt-4">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-dark"
            >
                Edit
            </a>


            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                class="d-inline"
            >
                <button
                    type="submit"
                    class="btn btn-danger"
                >
                    Delete this listing
                </button>
            </form>

        </div>

    </div>

</div>
