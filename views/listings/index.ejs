<% layout('/layouts/boilerplate')%>

<body>

    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">
        <% for(let listing of allListings) { %>
            <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="card col">
                <img src="<%= listing.image?.url || '/images/listing-placeholder.svg' %>" onerror="this.onerror=null; this.src='/images/listing-placeholder.svg';" class="card-img-top" alt="<%= listing.title %>" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                <p class="card-text"><b><%= listing.title %></b>
                <br>
                <%= listing.price.toLocaleString('en-IN') %>
                </p>
                </div>
            </div>
            </a>
        <% } %>
    </div>
</body>
