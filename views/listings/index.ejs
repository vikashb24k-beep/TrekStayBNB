<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TrekStayBNB-listings</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <h1>Welcome To TrekStayBNB</h1>
    <div>
        <form method="GET" action="/listings/new">
            <button>Create new </button>
        </form>
    </div>
    <div>
         <ul>
   <% for(let listing of allListings) { %>
        <a href="/listings/<%=listing._id %>"><li><%= listing.title %></li></a>
   <% } %>
</ul>
    </div>


</body>

</html>
